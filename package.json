{
  "name": "jmlparty-api",
  "description": "API for the Jumalauta party website(s)",
  "license": "UNLICENSED",
  "author": {
    "name": "Teemu Lahti",
    "email": "teemu.lahti@gmail.com"
  },
  "scripts": {
    "compile": "tsc",
    "deploy:dev": "node_modules/.bin/sls deploy --stage dev",
    "deploy:prod": "node_modules/.bin/sls deploy --stage production",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "start": "node_modules/.bin/sls dev",
    "test:integration": "vitest  -c vitest.integration.config.ts --run",
    "test:unit": "vitest  -c vitest.config.ts --run"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1124.0",
    "@middy/core": "7.9.2",
    "@middy/http-cors": "7.9.2",
    "@middy/http-error-handler": "7.9.2",
    "@middy/http-event-normalizer": "7.9.2",
    "@middy/http-header-normalizer": "7.9.2",
    "@middy/http-security-headers": "7.9.2",
    "date-fns": "4.4.0",
    "googleapis": "178.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@types/aws-lambda": "8.10.163",
    "aws-sdk-client-mock": "4.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unicorn": "65.0.1",
    "esnext": "3.3.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "serverless": "4.41.1",
    "serverless-domain-manager": "10.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
